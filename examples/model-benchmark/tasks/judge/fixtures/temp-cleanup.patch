diff --git a/tests/global-tmp.ts b/tests/global-tmp.ts
new file mode 100644
index 0000000..fff5cb5
--- /dev/null
+++ b/tests/global-tmp.ts
@@ -0,0 +1,64 @@
+// Gives each test run its own temp folder and removes it afterwards (#357).
+// Before this, 24 test files used mkdtempSync(join(tmpdir(), ...)) and never
+// cleaned up; a squad test copies about 38 MB per run, and 2205 leftover
+// /tmp/squad-* folders filled the /tmp quota. Instead of touching every test,
+// the run sets TMPDIR to a folder of its own, and the teardown removes it.
+// Tests that need a folder outside any git checkout still get one, because
+// the base folder is the system temp dir, which is outside the repo.
+import { mkdtempSync, readdirSync, rmSync, statSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { env } from 'node:process';
+
+const PREFIX = 'flow-tower-tests-';
+const MAX_AGE_MS = 24 * 60 * 60 * 1000;
+
+// Runs once in the main process before the workers start; workers and the
+// child processes they spawn inherit the environment set here.
+export default function globalTmp(): () => void {
+  // Read the base before changing TMPDIR, so the new folder lands in the
+  // real system temp dir rather than inside a previous run's folder.
+  const base = tmpdir();
+
+  // Leftovers from runs that crashed before their teardown. Only folders
+  // older than a day are removed, so a concurrent run's folder is safe.
+  const now = Date.now();
+  for (const name of readdirSync(base)) {
+    if (!name.startsWith(PREFIX)) continue;
+    const path = join(base, name);
+    try {
+      if (now - statSync(path).mtimeMs < MAX_AGE_MS) continue;
+      rmSync(path, { recursive: true, force: true });
+    } catch {
+      // One bad entry must not stop the cleanup of the others.
+    }
+  }
+
+  const dir = mkdtempSync(join(base, PREFIX));
+  const saved = {
+    TMPDIR: env.TMPDIR,
+    TMP: env.TMP,
+    TEMP: env.TEMP,
+  };
+  // TMP and TEMP are read by some Windows tools, so they point at the same folder.
+  env.TMPDIR = dir;
+  env.TMP = dir;
+  env.TEMP = dir;
+
+  return () => {
+    restore('TMPDIR', saved.TMPDIR);
+    restore('TMP', saved.TMP);
+    restore('TEMP', saved.TEMP);
+    try {
+      rmSync(dir, { recursive: true, force: true });
+    } catch (error) {
+      console.warn(`could not remove test temp folder ${dir}:`, error);
+    }
+  };
+}
+
+// Put back a variable exactly as it was; an unset variable is deleted, not set to "undefined".
+function restore(key: 'TMPDIR' | 'TMP' | 'TEMP', value: string | undefined): void {
+  if (value === undefined) delete env[key];
+  else env[key] = value;
+}
diff --git a/tests/squad-log-prune.test.ts b/tests/squad-log-prune.test.ts
new file mode 100644
index 0000000..4442f2e
--- /dev/null
+++ b/tests/squad-log-prune.test.ts
@@ -0,0 +1,46 @@
+import { mkdtempSync, rmSync, writeFileSync, readdirSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+// The runner's helper is plain .mjs with no types; the test imports it directly.
+// @ts-expect-error no declaration file for the runner's helper
+import { pickStale, pruneLogs } from '../tools/squad/log-prune.mjs';
+
+const DAY = 86_400_000;
+const NOW = Date.UTC(2026, 9, 31);
+// Timestamps are 13-digit ms values; `daysAgo` makes each log's age explicit.
+const logsAged = (n: number, daysAgo: number) =>
+  Array.from({ length: n }, (_, i) => `coder-${NOW - daysAgo * DAY - i}.log`);
+
+let dirs: string[] = [];
+afterEach(() => { for (const d of dirs) rmSync(d, { recursive: true, force: true }); dirs = []; });
+
+describe('pickStale', () => {
+  it('keeps the newest 200 regardless of age', () => {
+    const names = logsAged(205, 20);
+    const stale = pickStale(names, NOW);
+    expect(stale).toHaveLength(5);
+    // The five oldest are the stale ones; the 200 newest of the same age stay.
+    expect(stale).toEqual(names.slice(200));
+  });
+
+  it('marks nothing stale when all 205 logs are 1 day old', () => {
+    expect(pickStale(logsAged(205, 1), NOW)).toEqual([]);
+  });
+
+  it('never returns names that are not role logs', () => {
+    const names = ['squad.json', 'notes.log', 'coder-123.log', ...logsAged(1, 30)];
+    expect(pickStale(names, NOW, { keep: 0, maxAgeDays: 0 })).toEqual(logsAged(1, 30));
+  });
+});
+
+describe('pruneLogs', () => {
+  it('removes the stale logs beyond keep and leaves other files', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'squad-prune-'));
+    dirs.push(dir);
+    const names = logsAged(3, 30);
+    for (const n of [...names, 'squad.json']) writeFileSync(join(dir, n), '');
+    expect(pruneLogs(dir, NOW, { keep: 1, maxAgeDays: 0 })).toBe(2);
+    expect(readdirSync(dir).sort()).toEqual(['squad.json', names[0]].sort());
+  });
+});
