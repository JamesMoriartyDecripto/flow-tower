{
  "name": "flow-tower",
  "version": "0.4.0",
  "description": "Interactive 3D tower of flowchart layers to visualize and inspect AI agents and complex agentic systems.",
  "type": "module",
  "license": "MIT",
  "author": "JamesMoriartyDecripto",
  "repository": {
    "type": "git",
    "url": "https://github.com/JamesMoriartyDecripto/flow-tower.git"
  },
  "keywords": [
    "agents",
    "ai",
    "visualization",
    "three.js",
    "flowchart",
    "multi-agent",
    "llm"
  ],
  "bin": {
    "flow-tower": "bin/flow-tower.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node bin/flow-tower.js examples",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema": "node --experimental-strip-types scripts/gen-schema.ts",
    "check": "npm run typecheck && npm test",
    "stress": "node --experimental-strip-types scripts/gen-stress.ts",
    "simulate": "node --experimental-strip-types scripts/simulate.ts",
    "e2e": "playwright test",
    "build:demo": "node --experimental-strip-types scripts/build-demo.ts"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "scripts",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@vitejs/plugin-react": "^6.1.2",
    "elkjs": "^0.12.0",
    "fflate": "^0.8.3",
    "katex": "^0.16.47",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "troika-three-text": "^0.52.5",
    "vite": "^8.3.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
