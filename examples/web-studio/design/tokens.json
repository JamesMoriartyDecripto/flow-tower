{
  "$description": "Exported from Figma variables (Nordlicht Brand 2024) in W3C Design Tokens format; mapped to the Tailwind theme.",
  "color": {
    "brand": {
      "ink": { "$type": "color", "$value": "#1B1A17" },
      "roast": { "$type": "color", "$value": "#6B3E26" },
      "crema": { "$type": "color", "$value": "#E9D8C3" },
      "aurora": { "$type": "color", "$value": "#2F7A6B" }
    },
    "surface": {
      "default": { "$type": "color", "$value": "#FBF8F4" },
      "raised": { "$type": "color", "$value": "#FFFFFF" }
    },
    "text": {
      "default": { "$type": "color", "$value": "{color.brand.ink}" },
      "muted": { "$type": "color", "$value": "#5C574F", "$description": "5.9:1 on surface.default" },
      "on-accent": { "$type": "color", "$value": "#FFFFFF", "$description": "5.1:1 on brand.aurora" }
    },
    "focus": { "$type": "color", "$value": "#0B5FFF" }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "serif"] },
      "body": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "size": {
      "body": { "$type": "dimension", "$value": "1rem" },
      "h1": { "$type": "dimension", "$value": "clamp(2.25rem, 4vw + 1rem, 4rem)" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "16": { "$type": "dimension", "$value": "4rem" }
  },
  "radius": { "card": { "$type": "dimension", "$value": "12px" } },
  "size": { "target-min": { "$type": "dimension", "$value": "44px", "$description": "Above the WCAG 2.2 AA 24px minimum" } }
}
