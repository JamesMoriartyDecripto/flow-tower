{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebFetch",
      "Write(./runs/**)",
      "Edit(./runs/**)",
      "mcp__brave-search__brave_web_search",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__notion__notion-search",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-update-page",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_evaluate",
      "mcp__studio__synthesize_voice",
      "mcp__studio__render_media",
      "mcp__studio__scorm_package",
      "mcp__studio__request_signoff"
    ],
    "ask": [
      "mcp__studio__lms_upload",
      "mcp__notion__notion-create-pages",
      "Bash(npm install:*)"
    ],
    "deny": [
      "Write(./config/**)",
      "Write(./templates/**)",
      "Write(./memory/**)",
      "Edit(./config/**)",
      "Edit(./memory/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(curl:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "mcp__notion__notion-delete-page"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["brave-search", "context7", "notion", "playwright", "posthog"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "npx tsx \"$CLAUDE_PROJECT_DIR\"/src/hooks/cli.ts source-license" },
          { "type": "command", "command": "npx tsx \"$CLAUDE_PROJECT_DIR\"/src/hooks/cli.ts reading-level" },
          { "type": "command", "command": "npx tsx \"$CLAUDE_PROJECT_DIR\"/src/hooks/cli.ts pii-scan" }
        ]
      },
      {
        "matcher": "mcp__studio__scorm_package",
        "hooks": [{ "type": "command", "command": "npx tsx \"$CLAUDE_PROJECT_DIR\"/src/hooks/cli.ts a11y-gate", "timeout": 60 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "npx tsx \"$CLAUDE_PROJECT_DIR\"/src/hooks/cli.ts readability-feedback", "timeout": 30 }]
      }
    ]
  }
}
