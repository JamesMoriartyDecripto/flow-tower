{
  "$description": "Leafwise design tokens (W3C Design Tokens format), exported from Figma variables. Read by the Expo theme, the iOS widget and the Android Glance widget.",
  "color": {
    "leaf": {
      "50": { "$type": "color", "$value": "#EEF7EF" },
      "500": { "$type": "color", "$value": "#2F8F46" },
      "700": { "$type": "color", "$value": "#1F6431" }
    },
    "soil": {
      "500": { "$type": "color", "$value": "#7A5A3A" }
    },
    "surface": {
      "light": { "$type": "color", "$value": "#FFFFFF" },
      "dark": { "$type": "color", "$value": "#121613" }
    },
    "text": {
      "primary-light": { "$type": "color", "$value": "#16201A", "$description": "15.9:1 on surface.light" },
      "primary-dark": { "$type": "color", "$value": "#E8F0EA", "$description": "14.6:1 on surface.dark" },
      "secondary-light": { "$type": "color", "$value": "#4A5A50", "$description": "7.1:1 on surface.light" }
    },
    "due": { "$type": "color", "$value": "#B4462B", "$description": "Due-today accent; always paired with an icon and text, never color alone" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "16px" },
    "button": { "$type": "dimension", "$value": "12px" }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" }
  },
  "size": {
    "touch-min-ios": { "$type": "dimension", "$value": "44px", "$description": "44 x 44 pt minimum (HIG)" },
    "touch-min-android": { "$type": "dimension", "$value": "48px", "$description": "48 x 48 dp minimum (Material)" }
  },
  "typography": {
    "title": { "$type": "typography", "$value": { "fontFamily": "system", "fontWeight": 700, "fontSize": "28px", "lineHeight": 1.2 }, "$description": "Scales with Dynamic Type / font scale" },
    "body": { "$type": "typography", "$value": { "fontFamily": "system", "fontWeight": 400, "fontSize": "17px", "lineHeight": 1.35 } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "system", "fontWeight": 500, "fontSize": "13px", "lineHeight": 1.3 } }
  }
}
