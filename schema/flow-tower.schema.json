{
  "title": "Flow Tower",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "description": "Used to filter and group towers in the library view.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root": {
      "description": "Base directory for every relative path. Defaults to the tower file directory.",
      "type": "string"
    },
    "runtimes": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "local",
              "server",
              "cloud",
              "container",
              "serverless",
              "saas",
              "edge",
              "ci",
              "browser",
              "device"
            ]
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "host": {
            "description": "Machine, cluster or service name.",
            "type": "string"
          },
          "provider": {
            "description": "aws, gcp, hetzner, anthropic, vercel, github-actions...",
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?:\\/\\/"
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Free-form key/value metadata shown in the inspector."
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "prompts": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {
            "description": "Path to the prompt file, relative to `root`.",
            "type": "string"
          },
          "text": {
            "description": "Inline prompt text.",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "vars": {
            "description": "Template variables. Auto-detected from {{var}} when omitted.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "agents": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "from": {
            "description": "Import a Claude Code style agent file (.md with YAML frontmatter). Explicit fields override it.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "file": {
                    "description": "Path to the prompt file, relative to `root`.",
                    "type": "string"
                  },
                  "text": {
                    "description": "Inline prompt text.",
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "vars": {
                    "description": "Template variables. Auto-detected from {{var}} when omitted.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "harness": {
            "description": "Runtime settings: max_turns, temperature, permission_mode, budget...",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tower": {
            "description": "Path to a nested .tower.yaml describing this agent internals.",
            "type": "string"
          },
          "runtime": {
            "description": "Reference to an entry of the `runtimes` registry.",
            "type": "string"
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "log",
                    "script",
                    "dashboard",
                    "endpoint",
                    "config",
                    "doc",
                    "queue",
                    "database",
                    "repo",
                    "recording",
                    "other"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "path": {
                  "description": "Local file, opens in the viewer (logs show their tail).",
                  "type": "string"
                },
                "url": {
                  "description": "External link, opens in a new tab.",
                  "type": "string",
                  "pattern": "^https?:\\/\\/"
                }
              },
              "required": [
                "kind",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "match": {
            "description": "Live event rules, e.g. \"agent:coder\", \"tool:mcp__github__*\", \"source:hermes&tool:shell\".",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trigger": {
            "description": "What starts this node (entry nodes, scheduled agents).",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "manual",
                  "cron",
                  "webhook",
                  "event",
                  "queue",
                  "chat",
                  "email",
                  "file"
                ]
              },
              "schedule": {
                "description": "Cron expression for `cron` (e.g. \"0 9 * * 1-5\").",
                "type": "string"
              },
              "source": {
                "description": "Who fires it: PagerDuty, Gmail, a queue name, a Slack channel...",
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "approval": {
            "description": "Human-in-the-loop gate: who, how, deadline.",
            "type": "object",
            "properties": {
              "by": {
                "description": "Role or person who approves.",
                "type": "string"
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "approve",
                    "edit",
                    "reject",
                    "respond",
                    "snooze"
                  ]
                }
              },
              "timeout": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d|w)$"
              },
              "on_timeout": {
                "type": "string",
                "enum": [
                  "approve",
                  "reject",
                  "escalate",
                  "wait"
                ]
              },
              "via": {
                "description": "Slack, email, PR review, app...",
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "budget": {
            "type": "object",
            "properties": {
              "usd": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "tokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "turns": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "on_exceed": {
                "type": "string",
                "enum": [
                  "pause",
                  "stop",
                  "escalate",
                  "downgrade"
                ]
              }
            },
            "additionalProperties": false
          },
          "limits": {
            "type": "object",
            "properties": {
              "timeout": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d|w)$"
              },
              "ttl": {
                "description": "Lifetime of a session / sandbox / browser.",
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d|w)$"
              },
              "retries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "backoff": {
                "description": "e.g. \"exponential 2s..60s\".",
                "type": "string"
              },
              "max_iterations": {
                "description": "Bound for loops (review rounds, tournament rounds...).",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "concurrency": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "fanout": {
            "description": "Runs as N parallel copies.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 2,
                "maximum": 9007199254740991
              },
              {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 9007199254740991
                  },
                  "by": {
                    "description": "What decides the count.",
                    "type": "string"
                  }
                },
                "required": [
                  "max"
                ],
                "additionalProperties": false
              }
            ]
          },
          "data": {
            "description": "Sensitivity and residency of the data handled here.",
            "type": "object",
            "properties": {
              "sensitivity": {
                "type": "string",
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "pii",
                  "phi",
                  "pci",
                  "secret"
                ]
              },
              "region": {
                "description": "Where data must stay (eu, us, eu-west-1...).",
                "type": "string"
              },
              "retention": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d|w)$"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "evals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "target": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "higher_is_better": {
                  "description": "Defaults to true. Used to color value vs target.",
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "version": {
            "type": "string"
          },
          "rollout": {
            "type": "object",
            "properties": {
              "strategy": {
                "type": "string",
                "enum": [
                  "all",
                  "canary",
                  "ab",
                  "shadow",
                  "blue-green",
                  "rainbow"
                ]
              },
              "percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "previous": {
                "description": "Version being replaced (rollback target).",
                "type": "string"
              }
            },
            "required": [
              "strategy"
            ],
            "additionalProperties": false
          },
          "sla": {
            "description": "Deadline to complete (e.g. a regulatory 72h).",
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d|w)$"
          },
          "credentials": {
            "description": "Whose credentials the tools use: a service account, the author, or the end user.",
            "type": "string",
            "enum": [
              "service",
              "author",
              "user"
            ]
          },
          "sandbox": {
            "type": "object",
            "properties": {
              "network": {
                "type": "string",
                "enum": [
                  "none",
                  "allowlist",
                  "open"
                ]
              },
              "allow": {
                "description": "Allowed hosts when network is `allowlist`.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "filesystem": {
                "type": "string",
                "enum": [
                  "none",
                  "read-only",
                  "workspace",
                  "full"
                ]
              }
            },
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Free-form key/value metadata shown in the inspector."
          }
        },
        "additionalProperties": false
      }
    },
    "layers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "nodes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "type": {
                  "description": "Defaults to `agent` when `agent` is set, else `process`.",
                  "type": "string",
                  "enum": [
                    "entry",
                    "output",
                    "agent",
                    "process",
                    "decision",
                    "tool",
                    "model",
                    "memory",
                    "human",
                    "guard",
                    "hook"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "agent": {
                  "description": "Reference to an entry of the `agents` registry.",
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "prompt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "file": {
                          "description": "Path to the prompt file, relative to `root`.",
                          "type": "string"
                        },
                        "text": {
                          "description": "Inline prompt text.",
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "vars": {
                          "description": "Template variables. Auto-detected from {{var}} when omitted.",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "tools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tower": {
                  "type": "string"
                },
                "runtime": {
                  "description": "Reference to `runtimes`. Inherited from the agent when omitted.",
                  "type": "string"
                },
                "status": {
                  "description": "Defaults to `active`.",
                  "type": "string",
                  "enum": [
                    "active",
                    "planned",
                    "experimental",
                    "deprecated"
                  ]
                },
                "resources": {
                  "description": "Logs, scripts, dashboards, endpoints... related to this node.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "log",
                          "script",
                          "dashboard",
                          "endpoint",
                          "config",
                          "doc",
                          "queue",
                          "database",
                          "repo",
                          "recording",
                          "other"
                        ]
                      },
                      "label": {
                        "type": "string"
                      },
                      "path": {
                        "description": "Local file, opens in the viewer (logs show their tail).",
                        "type": "string"
                      },
                      "url": {
                        "description": "External link, opens in a new tab.",
                        "type": "string",
                        "pattern": "^https?:\\/\\/"
                      }
                    },
                    "required": [
                      "kind",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                },
                "match": {
                  "description": "Live event rules; inherited from the agent. Default: match by id, label, agent and tool names.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "trigger": {
                  "description": "What starts this node (entry nodes, scheduled agents).",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "manual",
                        "cron",
                        "webhook",
                        "event",
                        "queue",
                        "chat",
                        "email",
                        "file"
                      ]
                    },
                    "schedule": {
                      "description": "Cron expression for `cron` (e.g. \"0 9 * * 1-5\").",
                      "type": "string"
                    },
                    "source": {
                      "description": "Who fires it: PagerDuty, Gmail, a queue name, a Slack channel...",
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "approval": {
                  "description": "Human-in-the-loop gate: who, how, deadline.",
                  "type": "object",
                  "properties": {
                    "by": {
                      "description": "Role or person who approves.",
                      "type": "string"
                    },
                    "actions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "approve",
                          "edit",
                          "reject",
                          "respond",
                          "snooze"
                        ]
                      }
                    },
                    "timeout": {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d|w)$"
                    },
                    "on_timeout": {
                      "type": "string",
                      "enum": [
                        "approve",
                        "reject",
                        "escalate",
                        "wait"
                      ]
                    },
                    "via": {
                      "description": "Slack, email, PR review, app...",
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "budget": {
                  "type": "object",
                  "properties": {
                    "usd": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "tokens": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "turns": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "on_exceed": {
                      "type": "string",
                      "enum": [
                        "pause",
                        "stop",
                        "escalate",
                        "downgrade"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "timeout": {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d|w)$"
                    },
                    "ttl": {
                      "description": "Lifetime of a session / sandbox / browser.",
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d|w)$"
                    },
                    "retries": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "backoff": {
                      "description": "e.g. \"exponential 2s..60s\".",
                      "type": "string"
                    },
                    "max_iterations": {
                      "description": "Bound for loops (review rounds, tournament rounds...).",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "concurrency": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "additionalProperties": false
                },
                "fanout": {
                  "description": "Runs as N parallel copies.",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 2,
                          "maximum": 9007199254740991
                        },
                        "by": {
                          "description": "What decides the count.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "max"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "data": {
                  "description": "Sensitivity and residency of the data handled here.",
                  "type": "object",
                  "properties": {
                    "sensitivity": {
                      "type": "string",
                      "enum": [
                        "public",
                        "internal",
                        "confidential",
                        "pii",
                        "phi",
                        "pci",
                        "secret"
                      ]
                    },
                    "region": {
                      "description": "Where data must stay (eu, us, eu-west-1...).",
                      "type": "string"
                    },
                    "retention": {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d|w)$"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "evals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "value": {
                        "type": [
                          "number",
                          "string"
                        ]
                      },
                      "target": {
                        "type": [
                          "number",
                          "string"
                        ]
                      },
                      "higher_is_better": {
                        "description": "Defaults to true. Used to color value vs target.",
                        "type": "boolean"
                      },
                      "description": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^https?:\\/\\/"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  }
                },
                "version": {
                  "type": "string"
                },
                "rollout": {
                  "type": "object",
                  "properties": {
                    "strategy": {
                      "type": "string",
                      "enum": [
                        "all",
                        "canary",
                        "ab",
                        "shadow",
                        "blue-green",
                        "rainbow"
                      ]
                    },
                    "percent": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "previous": {
                      "description": "Version being replaced (rollback target).",
                      "type": "string"
                    }
                  },
                  "required": [
                    "strategy"
                  ],
                  "additionalProperties": false
                },
                "sla": {
                  "description": "Deadline to complete (e.g. a regulatory 72h).",
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(ms|s|m|h|d|w)$"
                },
                "credentials": {
                  "description": "Whose credentials the tools use: a service account, the author, or the end user.",
                  "type": "string",
                  "enum": [
                    "service",
